# Copiar a .env y ajustar. El .env real NO se versiona (esta en .gitignore).
# El stack de Docker funciona con o sin .env: docker-compose.yml aplica estos
# mismos valores como default via ${VAR:-default}.

# --- Conexion a PostgreSQL ---
# 'localhost' sirve para ejecutar el ETL/API en la maquina contra el Postgres
# de Docker. Dentro de la red de Compose, el host se sobreescribe a 'postgres'.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=taxi_dw
POSTGRES_USER=taxi_user
POSTGRES_PASSWORD=taxi_password

# --- Periodos por defecto del pipeline ---
TAXI_TYPE=yellow
START_YEAR=2024
START_MONTH=1
MONTHS_TO_PROCESS=3

# --- API ---
API_PORT=5000
API_WORKERS=2
DB_POOL_MIN=1
DB_POOL_MAX=10
